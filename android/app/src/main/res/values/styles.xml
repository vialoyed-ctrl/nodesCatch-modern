<resources>
    <style name="AppTheme" parent="AppThemeLight" />
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#087981</item>
        <item name="android:windowBackground">#F4F7F9</item>
        <item name="android:statusBarColor">#F4F7F9</item>
        <item name="android:navigationBarColor">#F4F7F9</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#73DFD0</item>
        <item name="android:windowBackground">#080B10</item>
        <item name="android:statusBarColor">#080B10</item>
        <item name="android:navigationBarColor">#080B10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">#E8EEF7</item>
        <item name="android:textColorSecondary">#A4B2C5</item>
        <item name="android:colorBackground">#080B10</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
